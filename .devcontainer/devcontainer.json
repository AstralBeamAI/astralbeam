{
  "name": "${localWorkspaceFolderBasename}",
  // The root file makes each worktree directory its Compose project namespace: https://docs.docker.com/compose/how-tos/project-name/
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "astralbeam",
  "workspaceFolder": "/workspaces/astralbeam",
  "postCreateCommand": "deno task --cwd webapp --eval 'deno install --frozen' && deno task --cwd www --eval 'deno install --frozen'",
  // .env.development defaults to 127.0.0.1 for host workflows, but inside this container that loops back to astralbeam rather than its dependencies.
  // Override only editor subprocesses with Compose service DNS https://code.visualstudio.com/remote/advancedcontainers/environment-variables
  "remoteEnv": {
    "DATABASE_URL": "postgres://astralbeam:astralbeam123@pgbouncer:5432/astralbeam",
    "POSTGRES_HOST": "postgres",
    "VALKEY_HOST": "valkey",
    "SMTP_HOST": "mailpit"
  },
  "customizations": {
    "vscode": {
      // Keep in sync with .vscode/extensions.json recommendations.
      "extensions": [
        "ambar.bundle-size",
        "Anthropic.claude-code",
        "antfu.iconify",
        "anysphere.remote-containers",
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "denoland.vscode-deno",
        "eamodio.gitlens",
        "foxundermoon.shell-format",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "jgclark.vscode-todo-highlight",
        "mechatroner.rainbow-csv",
        "ms-playwright.playwright",
        "openai.chatgpt",
        "oxc.oxc-vscode",
        "redhat.vscode-yaml",
        "shd101wyy.markdown-preview-enhanced",
        "sst-dev.opencode",
        "streetsidesoftware.code-spell-checker",
        "tamasfe.even-better-toml",
        "vitest.explorer",
        "webpro.vscode-knip",
        "yoavbls.pretty-ts-errors",
        "yokawasa.jwt-debugger"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": "true",
      "configureZshAsDefaultShell": "true",
      "username": "root"
    },
    "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
      "plugins": "git zsh-autosuggestions",
      "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions.git"
    }
  }
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [5000, 5001],
  // Use 'postCreateCommand' to run commands after the container is created.
  // "postCreateCommand": "dotnet restore",
}
