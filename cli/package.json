{
  "name": "@astralbeam/cli",
  "version": "0.19.1",
  "description": "Command-line interface for AstralBeam organization admins and their coding agents",
  "homepage": "https://astralbeam.ai/docs/cli/getting-started",
  "bugs": "https://github.com/AstralBeamAI/astralbeam/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AstralBeamAI/astralbeam.git",
    "directory": "cli"
  },
  "bin": {
    "astralbeam": "dist/astralbeam.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "binary:check": "bun run compile && .output/astralbeam --version && .output/astralbeam skill > /dev/null",
    "build": "tsdown",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip",
    "check:fix": "bun run lint:fix && bun run format && bun run knip:fix",
    "count-lines": "bun run ../scripts/count-lines.ts",
    "compile": "bun run build && bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --asset skills --outfile .output/astralbeam dist/astralbeam.js",
    "dev": "bun run src/main.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files && knip --fix --allow-remove-files && bun install --frozen-lockfile",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "ready": "bun run ../scripts/ready.ts check test build count-lines",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@astralbeam/sdk": "workspace:*",
    "@types/bun": "1.4.3",
    "@types/node": "^26.2.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "commander": "^15.0.0",
    "eslint-plugin-regexp": "^3.3.1",
    "knip": "^6.32.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.3"
}
