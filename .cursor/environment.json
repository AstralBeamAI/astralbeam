{
  "name": "AstralBeam",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "install": "bun install --frozen-lockfile",
  "start": "service docker start && SERVICES=docker ./scripts/setup.sh",
  "ports": [
    {
      "name": "Product application",
      "port": 4500
    },
    {
      "name": "Public website",
      "port": 4600
    },
    {
      "name": "Todos example",
      "port": 4700
    }
  ],
  "terminals": [
    {
      "name": "Product application",
      "command": "bun run --cwd platform dev",
      "description": "Runs the TanStack Start application on port 4500."
    },
    {
      "name": "Public website",
      "command": "bun run --cwd website dev",
      "description": "Runs the public website on port 4600."
    }
  ]
}
