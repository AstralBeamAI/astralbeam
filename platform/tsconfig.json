{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".nitro", ".output", ".tanstack", ".tanstack-start", "dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2025", "DOM"],
    "paths": {
      "@/*": ["./src/*"],
      "@e2e/*": ["./e2e/*"],
      "@scripts/*": ["./scripts/*"],
      "@sdk/*": ["../sdk/src/*"],
      "@www/*": ["../www/src/*"]
    },
    "types": ["bun", "vite/client", "@tanstack/react-start"]
  }
}
