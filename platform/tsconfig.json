{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "include": ["src", "scripts", "e2e", "packages/sandbox/src", "*.ts", "*.tsx"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2025", "DOM"],
    "paths": {
      "@/*": ["./src/*"],
      "@e2e/*": ["./e2e/*"],
      "@scripts/*": ["./scripts/*"],
      "@sdk/*": ["../sdk/src/*"],
      "@website/*": ["../website/src/*"]
    },
    "types": ["bun", "vite/client", "@tanstack/react-start"]
  }
}
