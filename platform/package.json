    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "minisearch": "^7.2.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "posthog-js": "^1.438.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.1",
    "resend": "^6.33.0",
    "shadcn": "^4.21.5",
    "sharp": "^0.35.5",
    "tanstack-router-theme-provider": "^0.1.5",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@csstools/color-helpers": "6.1.2",
    "@csstools/css-color-parser": "4.2.6",
    "@csstools/css-parser-algorithms": "4.0.2",
    "@csstools/css-tokenizer": "4.0.2",
    "@effect/vitest": "^4.0.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-plugin-query": "^5.104.2",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/eslint-plugin-start": "^0.1.0",
    "@types/bun": "1.4.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/eslint-plugin": "^1.6.27",
