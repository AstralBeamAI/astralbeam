{
  "name": "@astralbeam/platform",
  "version": "0.13.4",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "generate:openapi": "deno run -P=tooling scripts/export-openapi.ts",
    "build": "deno task generate:openapi && NODE_ENV=production vite build && deno compile --no-check --node-modules-dir=none --exclude-unused-npm --unstable-detect-cjs --include npm:busboy --include .output --include src/db/migrations --config deno.jsonc -P=runtime --output .output/astralbeam-platform src/main.ts",
    "start": "deno run --config deno.jsonc -P=runtime src/main.ts",
    "binary:check": "deno run --env-file=.env.test -P=tooling scripts/check-binary.ts",
    "check": "deno task format:check && deno task generate:openapi --check && deno task lint && deno task typecheck && deno task knip",
    "check:fix": "deno task generate:png && deno task generate:openapi && deno task lint:fix && deno task knip:fix && deno task format",
    "db": "drizzle-kit",
    "db-reset": "deno run -P=tooling scripts/reset-database.ts",
    "db-seed": "deno run -P=tooling scripts/seed-database.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:png": "deno run -P=tooling scripts/export-png.ts",
    "generate:theme": "deno run -P=tooling scripts/generate-theme.ts",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files && knip --fix --allow-remove-files && SHARP_IGNORE_GLOBAL_LIBVIPS=1 deno install --frozen",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "ready": "deno task check && deno task test && deno task build",
    "test": "vitest run",
    "typecheck": "deno check --node-modules-dir=manual --unstable-sloppy-imports",
    "ui": "shadcn"
  },
  "dependencies": {
    "@astralbeam/sdk": "file:../sdk",
    "@aws-sdk/client-sesv2": "^3.1115.0",
    "@base-ui/react": "^1.6.0",
    "@better-auth-ui/core": "1.7.12",
    "@better-auth-ui/react": "1.7.12",
    "@better-auth/api-key": "^1.7.5",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@effect/platform-deno": "^4.0.0-rc.117",
    "@effect/sql-pg": "^4.0.0-rc.117",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@marsidev/react-turnstile": "^1.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/render": "2.1.0",
    "@scalar/api-reference": "^1.67.0",
    "@tanstack/ai": "^0.49.1",
    "@tanstack/ai-openai": "^0.22.0",
    "@tanstack/ai-sandbox": "^0.5.1",
    "@tanstack/ai-sandbox-daytona": "^0.3.2",
    "@tanstack/ai-sandbox-docker": "^0.3.2",
    "@tanstack/ai-sandbox-sprites": "^0.2.4",
    "@tanstack/ai-sandbox-vercel": "^0.2.4",
    "@tanstack/highlight": "^0.0.10",
    "@tanstack/markdown": "^0.0.13",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "5.102.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "^1.168.32",
    "better-auth": "^1.7.5",
    "bowser": "^2.14.1",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "commander": "^15.0.0",
    "drizzle-orm": "^1.0.0-rc.5",
    "effect": "^4.0.0-rc.117",
    "fflate": "^0.8.3",
    "jose": "^6.2.10",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-email": "^6.9.2",
    "resend": "^6.21.0",
    "shadcn": "^4.20.1",
    "tanstack-router-theme-provider": "^0.1.5",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@csstools/color-helpers": "6.1.0",
    "@csstools/css-color-parser": "4.1.10",
    "@csstools/css-parser-algorithms": "4.0.0",
    "@csstools/css-tokenizer": "4.0.0",
    "@effect/vitest": "^4.0.0-rc.117",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/eslint-plugin-query": "^5.103.2",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/eslint-plugin-start": "^0.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/eslint-plugin": "^1.6.27",
    "drizzle-kit": "^1.0.0-rc.5",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-dom": "^5.20.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-jsx": "^5.20.5",
    "eslint-plugin-react-web-api": "^5.20.5",
    "eslint-plugin-regexp": "^3.3.1",
    "knip": "^6.32.0",
    "nitro": "3.0.260903-beta",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "seroval": "1.6.3",
    "sharp": "^0.34.3",
    "tailwindcss": "^4",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
