    "@tanstack/ai-sandbox-sprites": "^1.0.0",
    "@tanstack/ai-sandbox-vercel": "^1.0.0",
    "@tanstack/highlight": "^1.1.0",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "5.104.2",
