    "eslint-plugin-regexp": "^3.3.1",
    "knip": "^6.41.0",
    "nitro": "3.0.260903-beta",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "seroval": "1.6.9",
    "tailwindcss": "^4",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "bun@1.4.4"
}
