{
  "name": "@astralbeam/platform",
  "version": "0.23.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "generate:openapi": "bun run scripts/export-openapi.ts",
    "build": "bun run generate:openapi && NODE_ENV=production vite build && bun run compile",
    "start": "bun run src/main.ts",
    "binary:check": "bun run --env-file=.env.test scripts/check-binary.ts",
    "check": "bun run format:check && bun run generate:openapi --check && bun run lint && bun run knip",
    "check:fix": "bun run generate:png && bun run generate:openapi && bun run lint:fix && bun run knip:fix && bun run format",
    "count-lines": "bun run ../scripts/count-lines.ts",
    "db": "bun run scripts/database.ts",
    "db-reset": "bun run scripts/reset-database.ts",
    "db-seed": "bun run scripts/seed-database.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "e2e:seeded": "E2E_SEEDED=1 playwright test --config e2e/playwright.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:png": "bun run scripts/export-png.ts",
    "generate:theme": "bun run scripts/generate-theme.ts",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files && knip --fix --allow-remove-files && bun install --frozen-lockfile",
    "lint": "oxlint --type-check",
    "lint:fix": "oxlint --fix",
    "ready": "bun run ../scripts/ready.ts check test build count-lines",
    "test": "vitest run",
    "ui": "shadcn",
    "compile": "NODE_ENV=production bun build --compile --compile-autoload-package-json --compile-autoload-dotenv --no-compile-autoload-bunfig --asset .output/server --asset .output/public --asset src/db/migrations --outfile .output/astralbeam-platform src/main.ts"
  },
  "dependencies": {
    "@astralbeam/sdk": "workspace:*",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/client-sesv2": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth-ui/core": "1.7.12",
    "@better-auth-ui/react": "1.7.12",
    "@better-auth/api-key": "^1.7.7",
    "@better-auth/core": "1.7.7",
    "@better-auth/drizzle-adapter": "^1.7.7",
