{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Use `/** @knipignore */` only for exports whose external use cannot be represented in the entry graph.
  // https://knip.dev/reference/jsdoc-tsdoc-tags
  "tags": ["-knipignore"],
  // Entry files are execution roots, not permission to expose every symbol they contain.
  "includeEntryExports": true,
  "treatConfigHintsAsErrors": true,
  "treatTagHintsAsErrors": true,
  // Let Knip delete unreachable registry files without rewriting generated symbols inside retained files.
  "ignoreIssues": {
    "src/components/ui/**": [
      "exports",
      "nsExports",
      "types",
      "nsTypes",
      "enumMembers",
      "namespaceMembers",
    ],
  },
  // The suite's config lives under `e2e/`, so Knip's Playwright plugin is pointed at it
  // explicitly; its spec files and setup are the execution roots. https://knip.dev/reference/plugins/playwright
  "playwright": {
    "config": ["e2e/playwright.config.ts"],
    "entry": ["e2e/*.setup.ts", "e2e/specs/**/*.spec.ts"],
  },
  "workspaces": {
    ".": {
      // Keep Bun-run generators and framework entry points explicit.
      "entry": [
        "e2e/mailbox-server.ts",
        "e2e/prepare-database.ts",
        "scripts/*.ts",
        "src/client.tsx",
        "src/lib/runtime/nitro-logging-plugin.server.ts",
        "src/lib/runtime/response-headers.server.ts",
        "src/lib/cluster/plugin.ts",
        "src/main.ts",
        "src/router.tsx",
        "src/start.ts",
      ],
    },
    // Platform consumes the generated bundle, so its source entry defines the package's public API.
    "packages/sandbox": { "includeEntryExports": false },
  },
}
