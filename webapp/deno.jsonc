{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "nodeModulesDir": "auto",
  // msgpackr-extract is optional native acceleration; installs skip its Node-only probe under Deno. https://github.com/kriszyp/msgpackr#native-acceleration
  // Sharp validates its lockfile-pinned prebuilt binary during install. https://sharp.pixelplumbing.com/install
  "allowScripts": ["npm:esbuild", "npm:msgpackr-extract", "npm:sharp"],
  "unstable": ["no-legacy-abort"],
  "permissions": {
    "tooling": {
      "env": true,
      "ffi": true,
      "net": true,
      "read": true,
      "run": true,
      "sys": true,
      "write": true
    },
    "runtime": {
      "env": true,
      "net": true,
      "read": true
    }
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": false,
    "proseWrap": "never",
    "exclude": [
      "src/components/ui",
      "src/routeTree.gen.ts",
      "src/db/migrations"
    ]
  },
  "lint": {
    "rules": {
      // Oxlint owns these duplicates; no-sloppy-imports remains disabled as an existing exception.
      // Sources: https://github.com/denoland/deno_lint/blob/main/src/rules.rs
      //          https://github.com/oxc-project/oxc/blob/main/crates/oxc_linter/src/rules.rs
      // Keep Deno's no-array-constructor: it covers zero/multiple arguments, while Oxlint's
      // unicorn/no-new-array covers one-argument `new Array` calls.
      // Sources: https://github.com/denoland/deno_lint/blob/main/src/rules/no_array_constructor.rs
      //          https://github.com/oxc-project/oxc/blob/main/crates/oxc_linter/src/rules/unicorn/no_new_array.rs
      "exclude": [
        "constructor-super",
        "for-direction",
        "getter-return",
        "jsx-no-children-prop",
        "jsx-no-comment-text-nodes",
        "jsx-void-dom-elements-no-children",
        "no-async-promise-executor",
        "no-class-assign",
        "no-compare-neg-zero",
        "no-cond-assign",
        "no-const-assign",
        "no-constant-condition",
        "no-control-regex",
        "no-debugger",
        "no-delete-var",
        "no-dupe-class-members",
        "no-dupe-else-if",
        "no-dupe-keys",
        "no-duplicate-case",
        "no-empty-character-class",
        "no-empty-pattern",
        "no-ex-assign",
        "no-extra-boolean-cast",
        "no-extra-non-null-assertion",
        "no-func-assign",
        "no-global-assign",
        "no-import-assign",
        "no-invalid-regexp",
        "no-irregular-whitespace",
        "no-misused-new",
        "no-new-symbol",
        "no-obj-calls",
        "no-regex-spaces",
        "no-self-assign",
        "no-setter-return",
        "no-shadow-restricted-names",
        "no-sloppy-imports",
        "no-this-alias",
        "no-this-before-super",
        "no-unreachable",
        "no-unsafe-finally",
        "no-unsafe-negation",
        "no-unused-labels",
        "no-unused-vars",
        "no-var",
        "no-with",
        "prefer-as-const",
        "prefer-const",
        "prefer-namespace-keyword",
        "require-await",
        "require-yield",
        "use-isnan",
        "valid-typeof"
      ]
    },
    "exclude": ["src/components/ui", "src/routeTree.gen.ts"]
  }
}
