{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "nodeModulesDir": "auto",
  // msgpackr-extract is optional native acceleration; installs skip its Node-only probe under Deno. https://github.com/kriszyp/msgpackr#native-acceleration
  "allowScripts": ["npm:esbuild", "npm:msgpackr-extract"],
  "unstable": ["no-legacy-abort"],
  "permissions": {
    "tooling": {
      "env": true,
      "ffi": true,
      "net": true,
      "read": true,
      "run": true,
      "sys": true,
      "write": true
    },
    "runtime": {
      "env": true,
      "net": true,
      "read": true
    }
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": false,
    "proseWrap": "never",
    "exclude": [
      "deno.lock",
      "src/components/ui",
      "src/routeTree.gen.ts",
      "src/db/migrations"
    ]
  },
  "lint": {
    "rules": {
      "tags": ["recommended", "jsx", "react"],
      "exclude": ["no-sloppy-imports"]
    },
    "exclude": ["src/routeTree.gen.ts", "src/db/migrations"]
  }
}
