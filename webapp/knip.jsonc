{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Use `/** @knipignore */` only for exports whose external use cannot be represented in the entry graph.
  // https://knip.dev/reference/jsdoc-tsdoc-tags
  "tags": ["-knipignore"],
  // Entry files are execution roots, not permission to expose every symbol they contain.
  "includeEntryExports": true,
  "treatConfigHintsAsErrors": true,
  "treatTagHintsAsErrors": true,
  // Let Knip delete unreachable registry files without rewriting generated symbols inside retained files.
  "ignoreIssues": {
    "src/components/ui/**": [
      "exports",
      "nsExports",
      "types",
      "nsTypes",
      "enumMembers",
      "namespaceMembers"
    ]
  },
  // @daytona/sdk ships `importHelpers` output that imports tslib without declaring it, so webapp
  // declares tslib only to make that specifier resolvable. https://www.typescriptlang.org/tsconfig/#importHelpers
  // @daytona/sdk also `createRequire`s busboy at download time, which the built server bundle keeps
  // as a runtime specifier; webapp declares busboy only so that require resolves.
  "ignoreDependencies": ["busboy", "tslib"],
  // Keep Deno-run generators and the TanStack Router entry explicit.
  "entry": [
    "scripts/*.ts",
    "src/router.tsx"
  ]
}
