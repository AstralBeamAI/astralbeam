{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Use `/** @knipignore */` only for exports whose external use cannot be represented in the entry graph.
  // https://knip.dev/reference/jsdoc-tsdoc-tags
  "tags": ["-knipignore"],
  "treatConfigHintsAsErrors": true,
  "treatTagHintsAsErrors": true,
  // Let Knip delete unreachable registry files without rewriting generated symbols inside retained files.
  "ignoreIssues": {
    "src/components/ui/**": [
      "exports",
      "nsExports",
      "types",
      "nsTypes",
      "enumMembers",
      "namespaceMembers"
    ]
  },
  // Keep Deno-run generators and the TanStack Router entry explicit. Email templates are entries too:
  // `scripts/preview-emails.ts` discovers them by reading the directory, not by importing them.
  "entry": [
    "scripts/*.ts",
    "src/router.tsx",
    "src/emails/templates/*.tsx"
  ]
}
