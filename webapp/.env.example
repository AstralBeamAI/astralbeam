# Local service defaults come from .env.development. Shell variables always win; use .env.development.local for mode-specific local overrides.
# DATABASE_URL=
# VALKEY_URL=
# APP_BASE_URL=

# Better Auth server configuration. APP_BASE_URL and BETTER_AUTH_URL must be the same origin.
BETTER_AUTH_URL=
# Generate independently per environment with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional public, client-visible legal links. Never put a secret in a VITE_ variable.
# VITE_PRIVACY_POLICY_URL=https://www.astralbeam.ai/privacy
# VITE_TERMS_OF_SERVICE_URL=https://www.astralbeam.ai/terms

# Required by /api/chat; set it in .env or the shell, never in a committed file.
# OPENAI_API_KEY=

# Defaults for src/emails `sendEmail`; local values come from .env.development and each call can override them with the `provider` and `from` options.
# EMAIL_PROVIDER=resend
# EMAIL_FROM_ADDRESS=

# Required only when EMAIL_PROVIDER=resend.
# RESEND_API_KEY=

# Required when EMAIL_PROVIDER=ses. Prefer an AWS role or profile through the SDK credential chain; if static credentials are unavoidable, set the access-key pair only in a secret store or ignored .env.local.
# AWS_REGION=
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
