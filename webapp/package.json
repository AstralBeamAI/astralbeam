{
  "name": "@astralbeam/webapp",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 4500",
    "generate-routes": "tsr generate",
    "build": "NODE_ENV=production vite build",
    "start": "deno run --config deno.jsonc -P=runtime .output/server/index.mjs",
    "compile": "deno compile -A --output .output/astralbeam .",
    "check": "deno task format:check && deno task lint && deno task typecheck && deno task knip",
    "check:fix": "deno task generate:png && deno fmt && deno task lint:fix",
    "db": "drizzle-kit",
    "db-reset": "deno run -P=tooling scripts/reset-database.ts",
    "drizzle-studio": "drizzle-kit studio",
    "format": "deno fmt",
    "format:check": "deno fmt --check",
    "generate:png": "deno run -P=tooling scripts/export-png.ts",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files && knip --fix --allow-remove-files && SHARP_IGNORE_GLOBAL_LIBVIPS=1 deno install",
    "lint": "deno task lint:oxlint && deno task lint:deno",
    "lint:deno": "deno lint",
    "lint:fix": "oxlint --fix && deno lint --fix",
    "lint:oxlint": "oxlint",
    "preview": "vite preview",
    "ready": "deno task check && deno task test && deno task build",
    "test": "vitest run",
    "typecheck": "deno check",
    "ui": "shadcn"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1115.0",
    "@base-ui/react": "^1.6.0",
    "@better-auth-ui/core": "1.7.12",
    "@better-auth-ui/react": "1.7.12",
    "@better-auth/api-key": "^1.7.2",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@csstools/color-helpers": "6.1.0",
    "@csstools/css-color-parser": "4.1.10",
    "@csstools/css-parser-algorithms": "4.0.0",
    "@csstools/css-tokenizer": "4.0.0",
    "@effect/sql-pg": "^4.0.0-rc.112",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@marsidev/react-turnstile": "^1.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/render": "2.1.0",
    "@tanstack/ai": "^0.49.1",
    "@tanstack/ai-openai": "^0.22.0",
    "@tanstack/ai-sandbox": "^0.5.1",
    "@tanstack/ai-sandbox-daytona": "^0.3.2",
    "@tanstack/ai-sandbox-docker": "^0.3.2",
    "@tanstack/ai-sandbox-sprites": "^0.2.4",
    "@tanstack/ai-sandbox-vercel": "^0.2.4",
    "@tanstack/markdown": "^0.0.13",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "5.102.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "^1.168.32",
    "better-auth": "^1.7.2",
    "bowser": "^2.14.1",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^1.0.0-rc.5",
    "effect": "^4.0.0-rc.112",
    "jose": "^6.2.10",
    "nodemailer": "^9.0.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-email": "^6.9.2",
    "resend": "^6.21.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tanstack-router-theme-provider": "^0.1.5",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.0-rc.112",
    "@tailwindcss/vite": "^4",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/eslint-plugin-start": "^0.1.0",
    "@tanstack/router-cli": "^1.167.21",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitejs/plugin-react": "^6",
    "drizzle-kit": "^1.0.0-rc.5",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-dom": "^5.18.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-jsx": "^5.18.6",
    "eslint-plugin-react-web-api": "^5.18.6",
    "eslint-plugin-regexp": "^3.2.0",
    "knip": "^6.32.0",
    "nitro": "3.0.260610-beta",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "sharp": "^0.34.3",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.3"
  }
}
