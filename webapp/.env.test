# Kept separate from .env.development so tests use astralbeam_test. Runtime settings live in the
# database config table; tests must inject email and OAuth boundaries rather than reading config.
DATABASE_URL=${DATABASE_URL:-postgres://${POSTGRES_USER:-astralbeam}:${POSTGRES_PASSWORD:-astralbeam}@${POSTGRES_HOST:-127.0.0.1}:${POSTGRES_HOST_PORT:-5432}/astralbeam_test}
