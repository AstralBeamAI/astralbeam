{
  "name": "@astralbeam/example-linearity-react",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip",
    "check:fix": "bun run lint:fix && bun run format",
    "dev": "vite",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:capture": "E2E_CAPTURE=true playwright test --config e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files && knip --fix --allow-remove-files && bun install --frozen-lockfile",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "ready": "bun run ../../scripts/ready.ts check test build",
    "start": "bun run --env-file=.env.local .output/server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ui": "shadcn"
  },
  "dependencies": {
    "@astralbeam/sdk": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/eslint-plugin-start": "^0.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-dom": "^5.26.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-jsx": "^5.26.5",
    "eslint-plugin-react-web-api": "^5.26.5",
    "eslint-plugin-regexp": "^3.3.1",
    "knip": "^6.41.0",
    "nitro": "3.0.261029-rc",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
