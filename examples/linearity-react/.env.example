# Copy to .env.local. Choose your own Basic Auth credentials, even for local development.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
# Confidential organization API key. Never use a VITE_ prefix for secrets.
ASTRALBEAM_API_KEY=
# Canonical public origin when running behind a TLS-terminating proxy. No trailing slash.
APP_ORIGIN=
# Browser-visible values are embedded at build time.
VITE_ASTRALBEAM_API_URL=https://app.astralbeam.ai/api
VITE_ASTRALBEAM_AGENT_ID=
