# Copy to .env. `deno task --cwd webapp db-seed` writes one for the local seed database.
# Server-only: key_<organizationId>_<id>_abo_<secret>, from the dashboard's API keys page.
ASTRALBEAM_API_KEY=
# Browser-safe. Leave empty to use the organization's default agent.
ASTRALBEAM_AGENT_ID=
# The AstralBeam API base. Defaults to the local webapp.
# ASTRALBEAM_API_URL=http://localhost:4500/api
# Loads the SDK from somewhere other than jsDelivr, such as a local build.
# ASTRALBEAM_SDK_URL=http://localhost:4601/client.js
