{
  "name": "@astralbeam/example-todos",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "deno task format:check && deno task lint && deno task typecheck && deno task knip",
    "check:fix": "deno task lint:fix && deno task format",
    "dev": "vite",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:capture": "E2E_CAPTURE=all playwright test --config e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files && knip --fix --allow-remove-files && deno install --frozen",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "ready": "deno task check && deno task test && deno task build",
    "start": "deno run --config deno.jsonc -P=runtime .output/server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astralbeam/sdk": "file:../../sdk",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "knip": "^6.32.2",
    "nitro": "3.0.260610-beta",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.3"
  }
}
