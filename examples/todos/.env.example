# Copy these from the organization API-key creation dialog and configure both on the server.
# The ID is public metadata; the API-key value is the secret.
# ID format: key_<organization slug>_<key slug>
ASTRALBEAM_API_KEY_ID=
ASTRALBEAM_API_KEY=

# Copy the public ID from the organization's agent page. This value is browser-safe.
# Format: agt_<organization slug>_<agent slug>
VITE_ASTRALBEAM_AGENT_ID=
