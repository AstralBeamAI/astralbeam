# Copy the one-time value from the organization API-key creation dialog, or use the key
# `deno task --cwd platform db-seed` prints for the seeded `acme` organization.
# This server-only value has the format key_<organization UUID>_<key UUID>_abo_<secret>.
ASTRALBEAM_API_KEY=

# Optional: leave empty to use the organization's default agent. To pin one agent, copy its
# ID from the organization's agents page; it is opaque and browser-safe.
# Format: agent_<organization UUID>_<agent UUID>
VITE_ASTRALBEAM_AGENT_ID=

# Optional: base URL of the AstralBeam API. Defaults to http://localhost:4500/api, the platform's
# development server. Set it when the platform runs on another port.
VITE_ASTRALBEAM_API_URL=
