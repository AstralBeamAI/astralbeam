# Copy the one-time value from the organization API-key creation dialog.
# This server-only value has the format key_<organization slug>_<key slug>_abo_<secret>.
ASTRALBEAM_API_KEY=

# Copy the public ID from the organization's agent page. This value is browser-safe.
# Format: agt_<organization slug>_<agent slug>
VITE_ASTRALBEAM_AGENT_ID=
