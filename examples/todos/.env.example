# Copy the one-time value from the organization API-key creation dialog, or use the key
# `deno task --cwd webapp db-seed` prints for the seeded `acme` organization.
# This server-only value has the format key_<organization slug>_<key slug>_abo_<secret>.
ASTRALBEAM_API_KEY=

# Optional: leave empty to use the organization's default agent. To pin one agent, copy its
# public ID from the organization's agents page; it is browser-safe.
# Format: agt_<organization slug>_<agent slug>
VITE_ASTRALBEAM_AGENT_ID=

# Optional: base URL of the AstralBeam API. Defaults to http://localhost:4500/api, the webapp's
# development server. Set it when the webapp runs on another port.
VITE_ASTRALBEAM_API_URL=
