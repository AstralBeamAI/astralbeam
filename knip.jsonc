{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Plugins are auto-enabled per workspace; pnpm workspaces and catalogs are discovered automatically.
  // https://knip.dev/reference/plugins
  // https://knip.dev/features/monorepos-and-workspaces
  // https://knip.dev/features/catalogs
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    "apps/www": {
      // Astro's compiler does not follow external script src references, so keep this production entry at workspace level.
      // https://github.com/webpro-nl/knip/blob/main/packages/knip/src/plugins/astro/compiler.ts
      "entry": ["src/scripts/main.ts!"],
    },
  },
}
