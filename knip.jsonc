{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Plugins are auto-enabled per workspace; pnpm workspaces and catalogs are discovered automatically.
  // https://knip.dev/reference/plugins
  // https://knip.dev/features/monorepos-and-workspaces
  // https://knip.dev/features/catalogs
  // Use `/** @knipignore */` only for exports whose external use cannot be represented in the entry graph.
  // https://knip.dev/reference/jsdoc-tsdoc-tags
  "tags": ["-knipignore"],
  "treatConfigHintsAsErrors": true,
  "treatTagHintsAsErrors": true,
  "workspaces": {
    "apps/webapp": {
      // Preserve app-local scaffolds before a route consumes them.
      "entry": ["src/components/ui/*.tsx!", "src/database/database.ts!", "src/theme/theme.ts!"],
    },
    "apps/www": {
      // Suppression examples for runtime-only edges; keep commented until a concrete exception is required.
      // "ignoreDependencies": ["runtime-loaded-package"],
      // "ignore": ["src/runtime-loaded/**"],
      // Applications are self-contained, so their source entry exports must also be used within the monorepo.
      // https://knip.dev/reference/configuration#includeentryexports
      "includeEntryExports": true,
      // Astro's compiler does not follow external script src references, so keep this production entry at workspace level.
      // https://github.com/webpro-nl/knip/blob/main/packages/knip/src/plugins/astro/compiler.ts
      "entry": ["src/scripts/main.ts!"],
    },
  },
}
