{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  // Projects keep their own toolchains without a workspace. Delegated tasks use --cwd.
  // https://docs.deno.com/runtime/reference/cli/task/
  "tasks": {
    // Nested project configs would override the root ignore of subdirectories.
    // https://oxc.rs/docs/guide/usage/formatter/config.html
    "format": "deno run -A npm:oxfmt@0.70.0 --disable-nested-config",
    "format:check": "deno run -A npm:oxfmt@0.70.0 --disable-nested-config --check",

    "install:webapp": "cd webapp && deno install",
    "install:www": "cd www && deno install",
    "install:sdk": "cd sdk && deno install",
    "install:todos": "cd examples/todos && deno install",
    "install": "deno task install:sdk && deno task install:webapp && deno task install:www && deno task install:todos",

    "dev:webapp": "deno task --cwd webapp dev",
    "dev:www": "deno task --cwd www dev",
    "dev:sdk": "deno task --cwd sdk dev",
    "dev:todos": "deno task --cwd examples/todos dev",
    // The SDK has no dev server; its watcher rewrites the `dist` output the todos example loads,
    // so a page reload picks up an SDK source change.
    "dev": {
      "description": "Run the webapp, website, and todos dev servers plus the SDK watcher concurrently",
      "dependencies": ["dev:webapp", "dev:www", "dev:sdk", "dev:todos"]
    },

    "build:sdk": "deno task --cwd sdk build",
    "build:webapp": "deno task --cwd webapp build",
    "build:www": "deno task --cwd www build",
    "build:todos": "deno task --cwd examples/todos build",
    // The SDK builds first because the webapp and todos example consume its linked `dist` output.
    "build": "deno task build:sdk && deno task build:webapp && deno task build:www && deno task build:todos"
  }
}
