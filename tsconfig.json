{
  "$schema": "https://json.schemastore.org/tsconfig",
  "exclude": [
    "**/node_modules/**",
    "**/.nitro/**",
    "**/.output/**",
    "**/.tanstack/**",
    "**/.tanstack-start/**",
    "**/.wrangler/**",
    "**/dist/**"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "lib": ["ES2025"],
    "module": "Preserve",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@astralbeam/brand": ["./apps/webapp/src/brand/index.ts"],
      "@astralbeam/brand/*": ["./apps/webapp/src/brand/*"],
      "@astralbeam/theme": ["./apps/webapp/src/theme/theme.ts"],
      "@astralbeam/theme/*": ["./apps/webapp/src/theme/*"]
    }
  }
}
