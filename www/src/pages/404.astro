---
import SiteLayout from "@/layouts/SiteLayout.astro"
---
<SiteLayout
  title="404 - Signal lost | AstralBeam"
  description="The requested AstralBeam page does not exist."
  robots="noindex,nofollow"
  social={false}
>
  <div class="fx-scanlines" aria-hidden="true"></div>
  <div class="fx-vignette" aria-hidden="true"></div>
  <main class="hero" style="min-height: 100svh">
    <div class="hero-inner" style="text-align: center">
      <p class="eyebrow">// ERROR 404</p>
      <h1 class="display hero-title beam-text" style="font-size: clamp(3rem, 10vw, 7rem)">
        SIGNAL LOST
      </h1>
      <p class="hero-sub">This sector is uncharted. The page you requested does not exist.</p>
      <div class="hero-ctas">
        <a class="btn btn-primary btn-lg" href="/">RETURN TO BASE</a>
      </div>
    </div>
  </main>
</SiteLayout>
