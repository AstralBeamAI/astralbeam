{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".nitro", ".output", ".tanstack", ".tanstack-start", "dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"]
    },
    // `tsc` runs the typecheck, so unlike the Deno-checked projects this one declares Node's
    // types itself for the build config, the prerendered resource routes, and the suite.
    "types": ["node", "vite/client", "@tanstack/react-start"]
  }
}
