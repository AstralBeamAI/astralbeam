{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "nodeModulesDir": "auto",
  "allowScripts": ["npm:esbuild", "npm:workerd"],
  "unstable": ["fmt-component", "no-legacy-abort"],
  "permissions": {
    "tooling": {
      "env": true,
      "ffi": true,
      "net": true,
      "read": true,
      "run": true,
      "sys": true,
      "write": true
    }
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": false,
    "proseWrap": "never",
    "exclude": ["deno.lock"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended", "jsx"],
      "exclude": ["no-sloppy-imports", "no-window", "no-window-prefix"]
    }
  }
}
