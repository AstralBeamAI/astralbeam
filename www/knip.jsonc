{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "tags": ["-knipignore"],
  "treatConfigHintsAsErrors": true,
  "treatTagHintsAsErrors": true,
  // The website is self-contained, so source entry exports must also be used within this project.
  // https://knip.dev/reference/configuration#includeentryexports
  "includeEntryExports": true,
  // TanStack Start discovers these entry points by convention rather than through an import.
  "entry": ["src/client.tsx", "src/router.tsx"],
  // src/styles/index.css pulls font families in through bare `@import` specifiers,
  // which Knip parses but does not resolve back to a package. The build emits their woff2 files.
  "ignoreDependencies": [
    "@fontsource-variable/space-grotesk",
    "@fontsource/anton",
    "@fontsource/jetbrains-mono",
    "@fontsource/source-serif-4",
  ],
}
