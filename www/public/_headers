# TanStack Start hydrates each prerendered page through inline scripts and React emits inline
# `style` attributes, so `script-src` and `style-src` allow `'unsafe-inline'`. Vite inlines the
# smallest font subsets as `data:` URLs, so `font-src` allows `data:`.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
