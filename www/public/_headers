# TanStack Start hydrates each prerendered page through inline scripts and React emits inline
# `style` attributes, so `script-src` and `style-src` allow `'unsafe-inline'`.
# PostHog loads replay bundles and sends events through its own domains.
# https://posthog.com/docs/advanced/content-security-policy
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://*.posthog.com; worker-src 'self' blob: data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/website-assets/*
  Cache-Control: public, max-age=31536000, immutable

# Match public files exactly so missing paths do not inherit a fresh cache lifetime.
# https://developers.cloudflare.com/workers/static-assets/headers/
