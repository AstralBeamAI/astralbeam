---
import astralbeamDarkLogoUrl from "@astralbeam/brand/logo/svg/astralbeam-logo-dark.svg?url&no-inline"
import astralbeamLightLogoUrl from "@astralbeam/brand/logo/svg/astralbeam-logo-light.svg?url&no-inline"
import { palette } from "@astralbeam/brand"
import "@fontsource/anton"
import "@fontsource/jetbrains-mono"
import "@fontsource/jetbrains-mono/700.css"
import "@fontsource-variable/space-grotesk"
import "@/styles/global.css"

import { siteMetadata, siteUrl } from "@/lib/site"

interface Props {
  title: string
  description?: string
  canonicalPath?: string
  robots?: "index,follow" | "noindex,nofollow"
  social?: boolean
}

const {
  title,
  description = siteMetadata.description,
  canonicalPath,
  robots = canonicalPath ? "index,follow" : "noindex,nofollow",
  social = Boolean(canonicalPath),
} = Astro.props
const baseUrl = Astro.site?.href ?? siteMetadata.origin
const canonicalUrl = canonicalPath ? siteUrl(canonicalPath, baseUrl) : undefined
const homeUrl = siteUrl("/", baseUrl)
const iconUrl = siteUrl(siteMetadata.icon.path, baseUrl)
const iconSize = `${siteMetadata.icon.size}x${siteMetadata.icon.size}`
const socialImageUrl = siteUrl(siteMetadata.socialImage.path, baseUrl)
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${homeUrl}#organization`,
  name: siteMetadata.name,
  url: homeUrl,
  logo: iconUrl,
  description: siteMetadata.description,
  email: siteMetadata.email,
}
---

<!doctype html>
<html class="dark" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="application-name" content={siteMetadata.name} />
    <meta name="theme-color" content={palette.dark.background.srgbHex} />
    <meta name="color-scheme" content="dark" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/png" sizes={iconSize} href={siteMetadata.icon.path} />
    <link rel="icon" type="image/svg+xml" href={astralbeamLightLogoUrl} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href={astralbeamDarkLogoUrl} media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" sizes={iconSize} href={siteMetadata.icon.path} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="license" href="/licenses.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      social && canonicalUrl && (
        <>
          <meta property="og:site_name" content={siteMetadata.name} />
          <meta property="og:type" content="website" />
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:image" content={socialImageUrl} />
          <meta property="og:image:secure_url" content={socialImageUrl} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content={String(siteMetadata.socialImage.width)} />
          <meta property="og:image:height" content={String(siteMetadata.socialImage.height)} />
          <meta property="og:image:alt" content={siteMetadata.socialImage.alt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={socialImageUrl} />
          <meta name="twitter:image:alt" content={siteMetadata.socialImage.alt} />
        </>
      )
    }
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
