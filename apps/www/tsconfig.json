{
  "extends": ["../../tsconfig.json", "astro/tsconfigs/strict"],
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"],
      "@astralbeam/brand": ["../webapp/src/brand/index.ts"],
      "@astralbeam/brand/*": ["../webapp/src/brand/*"],
      "@astralbeam/theme": ["../webapp/src/theme/theme.ts"],
      "@astralbeam/theme/*": ["../webapp/src/theme/*"]
    },
    "types": ["node", "vite/client"]
  }
}
