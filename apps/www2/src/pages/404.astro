---
import "@fontsource/anton"
import "@fontsource/jetbrains-mono"
import "@fontsource-variable/space-grotesk"
import "@/styles/global.css"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — Signal lost | AstralBeam</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#04080a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="fx-scanlines" aria-hidden="true"></div>
    <div class="fx-vignette" aria-hidden="true"></div>
    <main class="hero" style="min-height: 100svh">
      <div class="hero-inner" style="text-align: center">
        <p class="eyebrow">// ERROR 404</p>
        <h1 class="display hero-title beam-text" style="font-size: clamp(3rem, 10vw, 7rem)">
          SIGNAL LOST
        </h1>
        <p class="hero-sub">This sector is uncharted. The page you requested does not exist.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary btn-lg" href="/">RETURN TO BASE</a>
        </div>
      </div>
