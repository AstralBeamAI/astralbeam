{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The shared base comes last so its options win over Astro's preset. https://www.typescriptlang.org/tsconfig/#extends
  "extends": ["astro/tsconfigs/strict", "../tsconfig.base.json"],
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  }
}
