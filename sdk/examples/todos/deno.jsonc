{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "nodeModulesDir": "auto",
  "fmt": {
    "lineWidth": 100,
    "semiColons": false,
    "proseWrap": "never",
    "exclude": ["deno.lock"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended", "jsx", "react"]
    }
  }
}
