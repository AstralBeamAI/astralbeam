{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "tags": ["-knipignore"],
  "treatConfigHintsAsErrors": true,
  "treatTagHintsAsErrors": true,
  // Bun-run generator scripts are explicit extension points, like platform's.
  "entry": ["scripts/*.ts", "src/**/*.test.{ts,tsx}"],
  // Keep unreachable registry files visible while ignoring their unused sub-exports.
  "ignoreIssues": {
    "src/widget/components/ui/**": [
      "exports",
      "nsExports",
      "types",
      "nsTypes",
      "enumMembers",
      "namespaceMembers",
    ],
  },
}
