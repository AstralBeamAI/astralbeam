{
  "name": "@astralbeam/sdk",
  "version": "0.0.1",
  "description": "Frontend SDK for AstralBeam: drop-in agent UI, chat streaming, and server helpers",
  "license": "MIT",
  "type": "module",
  "homepage": "https://astralbeam.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astralbeamai/astralbeam.git",
    "directory": "sdk"
  },
  "files": ["dist"],
  "sideEffects": false,
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "deno task generate:styles && tsdown",
    "generate:styles": "tailwindcss --input src/styles.css --output .generated/styles.css --minify && deno run --allow-read=.generated --allow-write=src/widget scripts/embed-styles.ts",
    "check": "deno task format:check && deno task lint && deno task typecheck && deno task knip",
    "check:fix": "deno fmt && deno lint --fix",
    "format": "deno fmt",
    "format:check": "deno fmt --check",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files && knip --fix --allow-remove-files && deno install",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "ready": "deno task check && deno task build",
    "typecheck": "tsc --noEmit",
    "ui": "shadcn"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/helpers": "^0.2.0",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/ai-client": "^0.24.0",
    "@tanstack/ai-react": "^0.20.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "knip": "^6.32.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "0.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
