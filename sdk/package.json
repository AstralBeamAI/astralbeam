{
  "name": "@astralbeam/sdk",
  "version": "0.6.0",
  "description": "Frontend SDK for AstralBeam: drop-in agent UI, chat streaming, and server helpers",
  "license": "MIT",
  "type": "module",
  "homepage": "https://astralbeam.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astralbeamai/astralbeam.git",
    "directory": "sdk"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client.d.ts"
      ],
      "core": [
        "./dist/core.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "deno task generate:styles && tsdown",
    "dev": "deno task generate:styles && tsdown --watch",
    "generate:styles": "tailwindcss --input src/styles.css --output .generated/styles.css --minify && deno run --allow-read=.generated --allow-write=src/widget scripts/embed-styles.ts",
    "check": "deno task generate:styles && deno task format:check && deno task lint && deno task typecheck && deno task knip",
    "check:fix": "deno fmt && deno lint --fix",
    "format": "deno fmt",
    "format:check": "deno fmt --check",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files && knip --fix --allow-remove-files && deno install --frozen",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "ready": "deno task check && deno task test && deno task build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ui": "shadcn"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/ai": "^0.49.1",
    "@tanstack/ai-client": "^0.28.0",
    "@tanstack/markdown": "^0.0.13",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "jose": "^6.2.9",
    "knip": "^6.32.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "0.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.3"
  }
}
