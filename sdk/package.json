{
  "name": "@astralbeam/sdk",
  "version": "0.17.0",
  "description": "Frontend SDK for AstralBeam: drop-in agent UI, chat streaming, and server helpers",
  "homepage": "https://astralbeam.ai",
  "bugs": "https://github.com/AstralBeamAI/astralbeam/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AstralBeamAI/astralbeam.git",
    "directory": "sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "api": [
        "./dist/api.d.ts"
      ],
      "client": [
        "./dist/client.d.ts"
      ],
      "core": [
        "./dist/core.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "exports": {
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run generate:styles && tsdown --platform browser",
    "dev": "bun run generate:styles && (tailwindcss --input src/styles.css --output .generated/styles.css --minify --watch=always & bun run scripts/embed-styles.ts --watch & tsdown --platform browser --watch --no-clean)",
    "generate:styles": "tailwindcss --input src/styles.css --output .generated/styles.css --minify && bun run scripts/embed-styles.ts",
    "generate:api": "orval && oxfmt src/api/generated",
    "api:check": "bun run generate:api && git diff --exit-code -- src/api/generated",
    "check": "bun run generate:styles && bun run api:check && bun run format:check && bun run lint && bun run typecheck && bun run knip",
    "check:fix": "bun run generate:styles && bun run generate:api && bun run lint:fix && bun run format && bun run knip:fix",
    "count-lines": "bun run ../scripts/count-lines.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files && knip --fix --allow-remove-files && bun install --frozen-lockfile",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "ready": "bun run ../scripts/ready.ts check test build count-lines",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ui": "shadcn"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/ai": "^0.68.0",
    "@tanstack/ai-client": "^0.39.2",
    "@tanstack/eslint-plugin-query": "^5.103.2",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.4",
    "@types/bun": "1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-dom": "^5.20.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-jsx": "^5.20.5",
    "eslint-plugin-react-web-api": "^5.20.5",
    "eslint-plugin-regexp": "^3.3.1",
    "jose": "^6.2.9",
    "knip": "^6.32.2",
    "orval": "8.39.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.3"
}
