{
  "name": "@astralbeam/sdk",
  "version": "0.13.1",
  "description": "Frontend SDK for AstralBeam: drop-in agent UI, chat streaming, and server helpers",
  "homepage": "https://astralbeam.ai",
  "bugs": "https://github.com/AstralBeamAI/astralbeam/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AstralBeamAI/astralbeam.git",
    "directory": "sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "api": [
        "./dist/api.d.ts"
      ],
      "client": [
        "./dist/client.d.ts"
      ],
      "core": [
        "./dist/core.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "exports": {
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "deno task generate:styles && tsdown",
    "dev": "deno task generate:styles && tsdown --watch",
    "generate:styles": "tailwindcss --input src/styles.css --output .generated/styles.css --minify && deno run --allow-read=.generated --allow-write=src/widget scripts/embed-styles.ts",
    "generate:api": "orval && oxfmt src/api/generated",
    "api:check": "deno task generate:api && git diff --exit-code -- src/api/generated",
    "check": "deno task generate:styles && deno task api:check && deno task format:check && deno task lint && deno task typecheck && deno task knip",
    "check:fix": "deno task generate:styles && deno task generate:api && deno task lint:fix && deno task format && deno task knip:fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files && knip --fix --allow-remove-files && deno install --frozen",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "ready": "deno task check && deno task test && deno task build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ui": "shadcn"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/ai": "^0.49.1",
    "@tanstack/ai-client": "^0.28.0",
    "@tanstack/eslint-plugin-query": "^5.103.2",
    "@tanstack/markdown": "^0.0.13",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@types/deno": "^2.7.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-dom": "^5.20.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-jsx": "^5.20.5",
    "eslint-plugin-react-web-api": "^5.20.5",
    "eslint-plugin-regexp": "^3.3.1",
    "jose": "^6.2.9",
    "knip": "^6.32.2",
    "orval": "8.30.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "0.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
